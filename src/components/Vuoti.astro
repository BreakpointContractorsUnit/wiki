---
// Mostra un testo semplice evidenziando i segnaposto tra parentesi quadre: "entro [N giorni]".
// Serve per i testi che arrivano dai file data/*.json, dove non si può scrivere HTML.
interface Props {
  testo: string;
}

const parti = Astro.props.testo.split(/(\[[^\]]+\])/g).filter(Boolean);
---

{parti.map((parte) => (/^\[[^\]]+\]$/.test(parte) ? <mark class="vuoto">{parte.slice(1, -1)}</mark> : parte))}
